{
  "id": "/",
  "name": "The Living Draft",
  "short_name": "Living Draft",
  "description": "A private notebook for your life, one memory at a time. Say a memory and watch it find its place.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#060509",
  "theme_color": "#17151c",
  "lang": "en",
  "dir": "ltr",
  "categories": ["lifestyle", "productivity", "books"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    {
      "src": "icons/maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Write a memory",
      "short_name": "Write",
      "url": "./capture",
      "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Hands-free",
      "short_name": "Listen",
      "description": "Talk and listen without looking at the screen, for earbuds and smart glasses",
      "url": "./listen",
      "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Glance",
      "short_name": "Glance",
      "description": "A tiny screen for watches: today's memory and a quick record button",
      "url": "./glance",
      "icons": [{ "src": "icons/shortcut-96.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
